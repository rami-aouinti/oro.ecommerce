{% extends '@OroUI/actions/index.html.twig' %}

{% oro_title_set({params : {'%entityName%': 'rami.academy.ticket.entity_plural_label'|trans}}) %}

{% block navButtons %}
    <div class="btn-group">
        <a href="{{ path('oro_rami_academy_ticket_create') }}" class="btn btn-primary">
            {{ 'oro.ui.create_entity'|trans({'%entityName%': 'rami.academy.ticket.entity_label'|trans}) }}
        </a>
    </div>
{% endblock %}

{% block pageHeader %}
    {% set breadcrumbs = {
        'entityTitle': 'rami.academy.ticket.entity_plural_label'|trans
    } %}
    {{ parent() }}
{% endblock %}

{% block content_datagrid %}
    {{ oro_datagrid_render_grid('rami-academy-ticket-grid') }}
{% endblock %}
