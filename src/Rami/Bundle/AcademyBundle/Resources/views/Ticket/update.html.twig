{% extends '@OroUI/actions/update.html.twig' %}

{% set formAction = entity.id ? path('oro_rami_academy_ticket_update', {id: entity.id}) : path('oro_rami_academy_ticket_create') %}

{% oro_title_set({params : {'%entityName%': 'rami.academy.ticket.entity_label'|trans}}) %}

{% block navButtons %}
    {{ UI.cancelButton(path('oro_rami_academy_ticket_index')) }}
    {{ UI.saveAndCloseButton() }}
{% endblock %}

{% block pageHeader %}
    {% set breadcrumbs = {
        'indexPath': path('oro_rami_academy_ticket_index'),
        'indexLabel': 'rami.academy.ticket.entity_plural_label'|trans,
        'entityTitle': entity.id ? entity.subject : 'oro.ui.create_entity'|trans({'%entityName%': 'rami.academy.ticket.entity_label'|trans})
    } %}
    {{ parent() }}
{% endblock %}

{% block content_data %}
    {% set dataBlocks = [{
        'title': 'General'|trans,
        'class': 'active',
        'subblocks': [{
            'data': [form_row(form.subject), form_row(form.description), form_row(form.status), form_row(form.priority), form_row(form.assignedTo), form_row(form.contact), form_row(form.account)]
        }]
    }] %}

    {% set data = { 'dataBlocks': dataBlocks } %}

    {{ parent() }}
{% endblock %}
